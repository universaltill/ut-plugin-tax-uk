{
  "id": "com.universaltill.tax-uk",
  "name": "UK VAT: Eat-in / Takeaway",
  "version": "1.4.0",
  "description": "Implements the UK VAT eat-in/takeaway switch (VAT Notice 709/1) and the UK service-charge/tip defaults, plus a VAT return figures CSV export for the shop's accountant (no HMRC connection).",
  "author": "Universal Till",
  "website": "https://universaltill.com",
  "canonical_type": "tax",
  "runtime": "wasm",
  "device_arch": "any",
  "min_pos_version": "0.30.11",
  "countries": ["GB"],
  "markets": ["GB"],
  "permissions": [
    "events:receive",
    "sales:read",
    "storage"
  ],
  "locales": [
    "en-GB"
  ],
  "entries": [
    {
      "type": "tax",
      "key": "eatin-standard-rate-uk",
      "label": "UK Eat-in/Takeaway VAT Switch",
      "sort_order": 5
    },
    {
      "type": "page",
      "key": "docs",
      "label": "How the eat-in/takeaway VAT switch works",
      "route": "/plugin/tax-uk-docs",
      "sort_order": 10
    },
    {
      "type": "export",
      "key": "vat-figures-uk",
      "label": "tax_uk.entry_vat_figures_label",
      "sort_order": 9,
      "entities": [
        "eod_closes"
      ]
    }
  ],
  "settings": [
    {
      "key": "eatin_standard_rate_by_tax_code",
      "default_value": {},
      "scope": "global"
    }
  ],
  "entrypoint": "./bin/plugin.wasm",
  "hooks": [
    {
      "event": "tax.rate.ask",
      "action": "tax.rate"
    },
    {
      "event": "charge.policy.ask",
      "action": "charge.policy"
    },
    {
      "event": "export.requested.ask",
      "action": "export.mtd_vat"
    }
  ]
}
